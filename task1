package main

import (
    "fmt"
    "time"
)

func main() {
    result := make(chan string)

    go func() {
        time.Sleep(3 * time.Second)
        result <- "ответ сервера"
    }()

    select {
    case res := <-result:
        fmt.Println(res)
    case <-time.After(2 * time.Second):
        fmt.Println("таймаут")
    }
}
